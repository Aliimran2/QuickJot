<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="note_title_style">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="note_body_style">
        <item name="android:padding">8dp</item>
        <item name="android:fontFamily">serif-monospace</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:maxLines">8</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="time_text_style">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#90CAF9</item>
        <item name="android:textSize">8sp</item>
    </style>

    <style name="fab_style">
        <item name="android:clickable">true</item>
        <item name="android:layout_margin">16dp</item>
        <item name="backgroundTint">#C5CAE9</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:contentDescription">@string/add_a_note</item>
        <item name="android:focusable">true</item>
    </style>
</resources>